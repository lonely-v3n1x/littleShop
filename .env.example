# Jehucal storefront integration (no key needed; override only if the API host moves)
# JEHUCAL_API_BASE=https://backend.jehucale-business.com

# Paystack webhook verification (optional; enables /api/webhooks/paystack).
# On Cloudflare set it with: npx wrangler secret put PAYSTACK_WEBHOOK_SECRET
# PAYSTACK_WEBHOOK_SECRET=

# Future services
# DATABASE_URL=
# MOMO_API_KEY=